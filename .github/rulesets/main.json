{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge", "squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "lint", "integration_id": 15368 },
          { "context": "test", "integration_id": 15368 },
          { "context": "fuzz-smoke", "integration_id": 15368 },
          { "context": "build", "integration_id": 15368 },
          { "context": "generate-check", "integration_id": 15368 },
          { "context": "envtest", "integration_id": 15368 },
          { "context": "helm", "integration_id": 15368 },
          { "context": "helm-install", "integration_id": 15368 },
          { "context": "terraform", "integration_id": 15368 },
          { "context": "actions-lint", "integration_id": 15368 },
          { "context": "pre-commit", "integration_id": 15368 },
          { "context": "commits", "integration_id": 15368 },
          { "context": "dependency-review", "integration_id": 15368 },
          { "context": "gitleaks", "integration_id": 15368 },
          { "context": "govulncheck", "integration_id": 15368 },
          { "context": "trivy", "integration_id": 15368 },
          { "context": "codeql", "integration_id": 15368 },
          { "context": "kind / e2e", "integration_id": 15368 }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "alerts_threshold": "errors",
            "security_alerts_threshold": "high_or_higher"
          }
        ]
      }
    }
  ]
}

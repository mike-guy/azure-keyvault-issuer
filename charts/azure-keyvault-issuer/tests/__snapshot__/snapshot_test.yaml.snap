  6: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: akvi
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: azure-keyvault-issuer
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: azure-keyvault-issuer-0.0.0
      name: akvi-azure-keyvault-issuer
      namespace: cert-manager
    spec:
      replicas: 2
      selector:
        matchLabels:
          app.kubernetes.io/component: controller
          app.kubernetes.io/instance: akvi
          app.kubernetes.io/name: azure-keyvault-issuer
      template:
        metadata:
          labels:
            app.kubernetes.io/component: controller
            app.kubernetes.io/instance: akvi
            app.kubernetes.io/name: azure-keyvault-issuer
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --log-level=info
                - --cluster-issuer-ambient-credentials=true
                - --issuer-ambient-credentials=false
                - --max-retry-duration=5m
                - --concurrent-workers=5
                - --graceful-shutdown-timeout=30s
                - --health-probe-bind-address=:8081
                - --metrics-bind-address=:8443
              env:
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: MEMORY_LIMIT_BYTES
                  valueFrom:
                    resourceFieldRef:
                      containerName: controller
                      resource: limits.memory
                - name: AZURE_CLIENT_ID
                  value: 00000000-0000-0000-0000-000000000001
                - name: AZURE_TENANT_ID
                  value: 00000000-0000-0000-0000-000000000002
                - name: AZURE_FEDERATED_TOKEN_FILE
                  value: /var/run/secrets/azure/tokens/azure-identity-token
              image: ghcr.io/mike-guy/azure-keyvault-issuer:0.0.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: health
              name: controller
              ports:
                - containerPort: 8081
                  name: health
                  protocol: TCP
                - containerPort: 8443
                  name: metrics
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: health
              resources:
                limits:
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 64Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 65532
                runAsNonRoot: true
                runAsUser: 65532
                seccompProfile:
                  type: RuntimeDefault
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/run/secrets/kubernetes.io/serviceaccount
                  name: kube-api-access
                  readOnly: true
                - mountPath: /var/run/secrets/azure/tokens
                  name: azure-identity-token
                  readOnly: true
          enableServiceLinks: false
          securityContext:
            fsGroup: 65532
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: akvi-azure-keyvault-issuer
          terminationGracePeriodSeconds: 40
          volumes:
            - emptyDir:
                sizeLimit: 16Mi
              name: tmp
            - name: kube-api-access
              projected:
                defaultMode: 292
                sources:
                  - serviceAccountToken:
                      expirationSeconds: 3607
                      path: token
                  - configMap:
                      items:
                        - key: ca.crt
                          path: ca.crt
                      name: kube-root-ca.crt
                  - downwardAPI:
                      items:
                        - fieldRef:
                            fieldPath: metadata.namespace
                          path: namespace
            - name: azure-identity-token
              projected:
                defaultMode: 292
                sources:
                  - serviceAccountToken:
                      audience: api://AzureADTokenExchange
                      expirationSeconds: 3600
                      path: azure-identity-token

renders the defaults:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: akvi
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: azure-keyvault-issuer
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: azure-keyvault-issuer-0.0.0
      name: akvi-azure-keyvault-issuer-controller
    rules:
      - apiGroups:
          - azure-keyvault-issuer.mike-guy.github.io
        resources:
          - azurekeyvaultissuers
          - azurekeyvaultclusterissuers
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - azure-keyvault-issuer.mike-guy.github.io
        resources:
          - azurekeyvaultissuers/status
          - azurekeyvaultclusterissuers/status
        verbs:
          - patch
      - apiGroups:
          - cert-manager.io
        resources:
          - certificaterequests
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - cert-manager.io
        resources:
          - certificaterequests/status
        verbs:
          - patch
      - apiGroups:
          - events.k8s.io
        resources:
          - events
        verbs:
          - create
          - patch

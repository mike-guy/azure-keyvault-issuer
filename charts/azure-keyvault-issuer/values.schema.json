{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "clusterResourceNamespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "maxConcurrentReconciles": { "type": ["integer", "null"], "minimum": 1 },
    "reconcileTimeout": {
      "type": ["string", "null"],
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
    },
    "caExpiryWarningThreshold": {
      "type": ["string", "null"],
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
    },
    "warnOnExportableCAKey": { "type": ["boolean", "null"] },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRetries": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
        "tryTimeout": {
          "type": ["string", "null"],
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": ["string", "integer", "null"],
          "pattern": "^(debug|info|error|[1-9][0-9]*)$",
          "minimum": 1
        },
        "encoder": { "type": ["string", "null"], "enum": ["json", "console", null] }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secure": { "type": "boolean" },
        "certSecretName": { "type": "string", "maxLength": 253 },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "tlsConfig": { "type": "object" }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "maxLength": 253 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "secretNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "approverRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceAccountName": { "type": "string", "minLength": 1, "maxLength": 253 },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsNonRoot", "runAsUser", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["RuntimeDefault", "Localhost"] },
            "localhostProfile": { "type": "string" }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "contains": { "const": "ALL" }
            }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "metricsFrom": { "type": "array", "items": { "type": "object" } },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "extraArgs": { "type": "array", "items": { "type": "string" } },
    "extraEnv": { "type": "array", "items": { "type": "object" } }
  }
}
